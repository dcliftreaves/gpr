+/* SPDX-License-Identifier: Apache-2.0 OR MIT */
+#include "../source/lib/vc5_decoder/headers.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define REQUIRE(x) do {if (!(x)) {fprintf(stderr,"dequantize line %d: %s\n",__LINE__,#x);exit(1);}} while (0)
+static void compare(PIXEL *input,PIXEL *output,int width,int quant) {
+    PIXEL *expected=malloc((size_t)width*sizeof(PIXEL));REQUIRE(expected);
+    for (int i=0;i<width;++i) expected[i]=DequantizedValue(input[i],quant);
+    REQUIRE(DequantizeBandRow16s(input,width,quant,output)==CODEC_ERROR_OKAY);
+    REQUIRE(!memcmp(expected,output,(size_t)width*sizeof(PIXEL)));
+    free(expected);
+}
+int main(void) {
+    /* The scalar single-value entry retains the original floating-point
+     * polynomial, independently of the new bounded row path. */
+    PIXEL tokens[513],output[515];
+    for (int i=0;i<511;++i) tokens[i+1]=(PIXEL)(i-255);
+    for (int quant=0;quant<=32767;++quant) {
+        for (int i=0;i<511;++i) output[i+2]=0;
+        compare(tokens+1,output+2,511,quant);
+    }
+    for (int quant_index=0;quant_index<5;++quant_index) {
+        const int quants[]={-1,0,1,32768,65535};
+        for (int width=1;width<=33;++width) {
+            PIXEL input[80],result[80];
+            for (int i=0;i<80;++i) input[i]=(PIXEL)((i*37)%511-255);
+            memset(result,0x5a,sizeof(result));
+            compare(input+1,result+3,width,quants[quant_index]);
+            for (int i=0;i<3;++i) REQUIRE(result[i]==0x5a5a);
+            for (int i=3+width;i<80;++i) REQUIRE(result[i]==0x5a5a);
+            compare(input+1,input+1,width,quants[quant_index]);
+        }
+    }
+    /* All 16-bit coefficients exercise the general-input fallback, including
+     * -32768 whose vector absolute value must be treated as unsigned 32768.
+     * Quantizer one keeps the original polynomial product inside int32. */
+    PIXEL *all=malloc(65536*sizeof(PIXEL)),*decoded=malloc(65536*sizeof(PIXEL));
+    REQUIRE(all && decoded);
+    for (int i=0;i<65536;++i) all[i]=(PIXEL)(i-32768);
+    compare(all,decoded,65536,1);free(all);free(decoded);
+    /* Partial overlap must preserve the original left-to-right scalar order. */
+    for (int direction=-1;direction<=1;direction+=2) {
+        PIXEL actual[80],expected[80];
+        for (int i=0;i<80;++i) actual[i]=expected[i]=(PIXEL)(i-40);
+        int start=direction>0 ? 1:2,finish=start+direction;
+        for (int i=0;i<33;++i) expected[finish+i]=DequantizedValue(expected[start+i],3);
+        REQUIRE(!DequantizeBandRow16s(actual+start,33,3,actual+finish));
+        REQUIRE(!memcmp(actual,expected,sizeof(actual)));
+    }
+    puts("PASS: stock dequantization token/quantizer domain, signed extremes, tails, alignment, in-place and overlap");
+    return 0;
+}
