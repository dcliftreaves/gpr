+
+CODEC_ERROR InvertSpatialQuant16s(gpr_allocator *allocator,
+                                  PIXEL *lowlow_band, int lowlow_pitch,
+                                  PIXEL *lowhigh_band, int lowhigh_pitch,
+                                  PIXEL *highlow_band, int highlow_pitch,
+                                  PIXEL *highhigh_band, int highhigh_pitch,
+                                  PIXEL *output_image, int output_pitch,
+                                  DIMENSION input_width, DIMENSION input_height,
+                                  DIMENSION output_width, DIMENSION output_height,
+                                  QUANT quantization[]) {
+    return InvertSpatialQuant16sCore(allocator,lowlow_band,lowlow_pitch,lowhigh_band,lowhigh_pitch,
+        highlow_band,highlow_pitch,highhigh_band,highhigh_pitch,output_image,output_pitch,
+        input_width,input_height,output_width,output_height,quantization,0);
+}
+
+CODEC_ERROR InvertSpatialQuantDescale16s(gpr_allocator *allocator,
+                                         PIXEL *lowlow_band, int lowlow_pitch,
+                                         PIXEL *lowhigh_band, int lowhigh_pitch,
+                                         PIXEL *highlow_band, int highlow_pitch,
+                                         PIXEL *highhigh_band, int highhigh_pitch,
+                                         PIXEL *output_image, int output_pitch,
+                                         DIMENSION input_width, DIMENSION input_height,
+                                         DIMENSION output_width, DIMENSION output_height,
+                                         int descale, QUANT quantization[]) {
+    return InvertSpatialQuantDescale16sCore(allocator,lowlow_band,lowlow_pitch,lowhigh_band,lowhigh_pitch,
+        highlow_band,highlow_pitch,highhigh_band,highhigh_pitch,output_image,output_pitch,
+        input_width,input_height,output_width,output_height,descale,quantization,0);
+}
+
+/* Explicit internal path: highpass bands already contain exact saturated
+ * dequantized values. Input planes remain borrowed throughout the inverse. */
+CODEC_ERROR InvertSpatialPrepared16s(gpr_allocator *allocator,
+                                  PIXEL *lowlow_band, int lowlow_pitch,
+                                  PIXEL *lowhigh_band, int lowhigh_pitch,
+                                  PIXEL *highlow_band, int highlow_pitch,
+                                  PIXEL *highhigh_band, int highhigh_pitch,
+                                  PIXEL *output_image, int output_pitch,
+                                  DIMENSION input_width, DIMENSION input_height,
+                                  DIMENSION output_width, DIMENSION output_height, int prescale) {
+    if (prescale==0) return InvertSpatialQuant16sCore(allocator,lowlow_band,lowlow_pitch,lowhigh_band,lowhigh_pitch,
+        highlow_band,highlow_pitch,highhigh_band,highhigh_pitch,output_image,output_pitch,
+        input_width,input_height,output_width,output_height,NULL,1);
+    if (prescale==2) return InvertSpatialQuantDescale16sCore(allocator,lowlow_band,lowlow_pitch,lowhigh_band,lowhigh_pitch,
+        highlow_band,highlow_pitch,highhigh_band,highhigh_pitch,output_image,output_pitch,
+        input_width,input_height,output_width,output_height,prescale,NULL,1);
+    return CODEC_ERROR_BAD_ARGUMENT;
+}
