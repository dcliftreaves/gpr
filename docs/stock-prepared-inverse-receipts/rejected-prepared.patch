+/* SPDX-License-Identifier: Apache-2.0 OR MIT */
+#include "../source/lib/vc5_decoder/headers.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define REQUIRE(x) do {if (!(x)) {fprintf(stderr,"prepared inverse line %d: %s\n",__LINE__,#x);exit(1);}} while (0)
+static void *owned[16];
+static unsigned allocations,live,fail_at;
+static void reset(unsigned failure) {
+    REQUIRE(!live);memset(owned,0,sizeof(owned));allocations=0;fail_at=failure;
+}
+static void *tracked_alloc(size_t size) {
+    REQUIRE(allocations<16);unsigned index=allocations++;
+    if (allocations==fail_at) return NULL;
+    void *p=malloc(size);REQUIRE(p);owned[index]=p;++live;return p;
+}
+static void tracked_free(void *p) {
+    for (unsigned i=0;i<allocations;++i) if (owned[i] && owned[i]==p) {
+        owned[i]=NULL;--live;free(p);return;
+    }
+    REQUIRE(0 && "free of borrowed or already freed input");
+}
+static void equivalent(unsigned width,unsigned height,unsigned crop_x,unsigned crop_y,
+    unsigned preset,unsigned prescale) {
+    const unsigned row=width+5,out_width=2*width-crop_x,out_height=2*height-crop_y,out_row=2*width+5;
+    const size_t count=(size_t)row*height+2,out_count=(size_t)out_row*out_height+2;
+    static const QUANT quants[][4]={{1,1,1,1},{1,24,24,12},{1,64,64,48},
+        {1,512,512,768},{1,32767,96,1}};
+    QUANT quant[4];memcpy(quant,quants[preset],sizeof(quant));
+    PIXEL *encoded[4],*prepared[4];
+    uint32_t random=width*17+height;
+    for (unsigned band=0;band<4;++band) {
+        encoded[band]=malloc(count*sizeof(PIXEL));prepared[band]=malloc(count*sizeof(PIXEL));
+        REQUIRE(encoded[band] && prepared[band]);
+        for (size_t i=0;i<count;++i) {
+            random=random*1664525u+1013904223u;
+            PIXEL value=band ? (PIXEL)((int)(random%511)-255):(PIXEL)(random>>16);
+            encoded[band][i]=value;
+            prepared[band][i]=band ? DequantizedValue(value,quant[band]):value;
+        }
+    }
+    PIXEL *reference=malloc(out_count*sizeof(PIXEL)),*result=malloc(out_count*sizeof(PIXEL));
+    REQUIRE(reference && result);memset(reference,0x5a,out_count*sizeof(PIXEL));memset(result,0x5a,out_count*sizeof(PIXEL));
+    gpr_allocator ordinary={malloc,free},tracked={tracked_alloc,tracked_free};
+    CODEC_ERROR error;
+    if (!prescale) error=InvertSpatialQuant16s(&ordinary,
+        encoded[0]+1,row*2,encoded[1]+1,row*2,encoded[2]+1,row*2,encoded[3]+1,row*2,
+        reference+1,out_row*2,width,height,out_width,out_height,quant);
+    else error=InvertSpatialQuantDescale16s(&ordinary,
+        encoded[0]+1,row*2,encoded[1]+1,row*2,encoded[2]+1,row*2,encoded[3]+1,row*2,
+        reference+1,out_row*2,width,height,out_width,out_height,prescale,quant);
+    REQUIRE(!error);reset(0);
+    REQUIRE(!InvertSpatialPrepared16s(&tracked,
+        prepared[0]+1,row*2,prepared[1]+1,row*2,prepared[2]+1,row*2,prepared[3]+1,row*2,
+        result+1,out_row*2,width,height,out_width,out_height,prescale));
+    REQUIRE(allocations==4 && !live);
+    REQUIRE(!memcmp(reference,result,out_count*sizeof(PIXEL)));
+    REQUIRE(result[0]==0x5a5a && result[out_count-1]==0x5a5a);
+    for (unsigned y=0;y<out_height;++y) for (unsigned x=out_width;x<out_row;++x)
+        REQUIRE(result[1+(size_t)y*out_row+x]==0x5a5a);
+    for (unsigned band=0;band<4;++band) {
+        for (size_t i=0;i<count;++i)
+            REQUIRE(prepared[band][i]==(band ? DequantizedValue(encoded[band][i],quant[band]):encoded[band][i]));
+        free(encoded[band]);free(prepared[band]);
+    }
+    free(reference);free(result);
+}
+static void failures(void) {
+    PIXEL bands[4][9]={{0}},output[36];gpr_allocator tracked={tracked_alloc,tracked_free};
+    for (unsigned prescale=0;prescale<=2;prescale+=2) for (unsigned failure=1;failure<=4;++failure) {
+        memset(output,0x5a,sizeof(output));reset(failure);
+        REQUIRE(InvertSpatialPrepared16s(&tracked,bands[0],6,bands[1],6,bands[2],6,bands[3],6,
+            output,12,3,3,6,6,prescale)==CODEC_ERROR_OUTOFMEMORY);
+        REQUIRE(!live && allocations==4);
+        for (unsigned i=0;i<36;++i) REQUIRE(output[i]==0x5a5a);
+    }
+    reset(0);
+    REQUIRE(InvertSpatialPrepared16s(&tracked,bands[0],6,bands[1],6,bands[2],6,bands[3],6,
+        output,12,3,3,6,6,1)==CODEC_ERROR_BAD_ARGUMENT);
+    REQUIRE(!live && !allocations);
+}
+int main(void) {
+    const unsigned widths[]={3,4,7,8,9,15,16,17,33},heights[]={3,4,9};unsigned cases=0;
+    for (unsigned w=0;w<sizeof(widths)/sizeof(widths[0]);++w)
+    for (unsigned h=0;h<sizeof(heights)/sizeof(heights[0]);++h)
+    for (unsigned x=0;x<2;++x) for (unsigned y=0;y<2;++y)
