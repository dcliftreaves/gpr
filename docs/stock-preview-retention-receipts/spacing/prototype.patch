diff --git a/source/lib/vc5_encoder/encoder.c b/source/lib/vc5_encoder/encoder.c
index 1935a2a..53b8d4e 100755
--- a/source/lib/vc5_encoder/encoder.c
+++ b/source/lib/vc5_encoder/encoder.c
@@ -2405,6 +2405,19 @@ CODEC_ERROR AllocEncoderTransforms(ENCODER *encoder)
                 wavelet->data[0]=(PIXEL *)data;
                 for (int band=1; band<MAX_BAND_COUNT; band++)
                     wavelet->data[band]=(PIXEL *)(data+(size_t)(wavelet_height+band-1)*wavelet->pitch);
+            } else if (encoder->compact_bands && encoder->retain_preview_bands && wavelet_index>0) {
+                // Retained planes otherwise start at repeating cache-set offsets
+                // for common image heights. Keep the row pitch unchanged while
+                // placing each band's base one cache line farther apart.
+                wavelet = allocator->Alloc(sizeof(WAVELET));
+                if (!wavelet) return CODEC_ERROR_OUTOFMEMORY;
+                InitWavelet(wavelet,wavelet_width,wavelet_height);
+                wavelet->pitch=((wavelet_width*sizeof(PIXEL)+63)&~(size_t)63)+64;
+                size_t stride=(size_t)wavelet_height*wavelet->pitch+64;
+                uint8_t *data=gpr_aligned_alloc(allocator,stride*MAX_BAND_COUNT);
+                if (!data) {allocator->Free(wavelet);return CODEC_ERROR_OUTOFMEMORY;}
+                for (int band=0;band<MAX_BAND_COUNT;++band)
+                    wavelet->data[band]=(PIXEL *)(data+(size_t)band*stride);
             } else {
 			    wavelet = CreateWavelet(allocator, wavelet_width, wavelet_height);
             }
