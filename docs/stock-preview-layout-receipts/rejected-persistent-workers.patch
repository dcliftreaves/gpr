+/* SPDX-License-Identifier: Apache-2.0 OR MIT */
+#ifndef GPR_PARALLEL_H
+#define GPR_PARALLEL_H
+
+// Private synchronous task group. Jobs borrow their context until run returns;
+// helpers persist, but no task or caller pointer survives the completion barrier.
+#include <condition_variable>
+#include <cstdint>
+#include <exception>
+#include <mutex>
+#include <stdexcept>
+#include <thread>
+
+class gpr_parallel_workers {
+    struct Job {
+        void *context=nullptr;
+        void (*invoke)(void *,unsigned)=nullptr;
+    } job;
+    const unsigned helpers;
+    std::thread threads[3];
+    std::mutex group_gate,mutex;
+    std::condition_variable changed,completed;
+    uint64_t generation=0;
+    unsigned active=0,pending=0;
+    bool stopping=false;
+    std::exception_ptr errors[3];
+
+    void worker(unsigned index) noexcept {
+        uint64_t seen=0;
+        for (;;) {
+            Job next;
+            {
+                std::unique_lock<std::mutex> lock(mutex);
+                changed.wait(lock,[&]{return stopping || generation!=seen;});
+                if (stopping) return;
+                seen=generation;
+                if (index>active) continue;
+                next=job;
+            }
+            std::exception_ptr error;
+            try {next.invoke(next.context,index);} catch (...) {error=std::current_exception();}
+            {
+                std::lock_guard<std::mutex> lock(mutex);
+                errors[index-1]=error;
+                if (!--pending) completed.notify_one();
+            }
+        }
+    }
+    void stop() noexcept {
+        {std::lock_guard<std::mutex> lock(mutex);stopping=true;}
+        changed.notify_all();
+        for (auto &thread:threads) if (thread.joinable()) thread.join();
+    }
+public:
+    explicit gpr_parallel_workers(unsigned count=3):helpers(count) {
+        if (count>3) throw std::invalid_argument("at most three helper threads");
+        try {
+            for (unsigned i=0;i<count;++i) threads[i]=std::thread(&gpr_parallel_workers::worker,this,i+1);
+        } catch (...) {stop();throw;}
+    }
+    ~gpr_parallel_workers() {stop();}
+    gpr_parallel_workers(const gpr_parallel_workers &)=delete;
+    gpr_parallel_workers &operator=(const gpr_parallel_workers &)=delete;
+
+    template<class Function> void run(unsigned count,Function function) {
+        if (!count || count>helpers+1) throw std::invalid_argument("invalid parallel task count");
+        std::lock_guard<std::mutex> owner(group_gate);
+        if (count==1) {function(0);return;}
+        {
+            std::lock_guard<std::mutex> lock(mutex);
+            job.context=&function;
+            job.invoke=[](void *context,unsigned index){(*static_cast<Function *>(context))(index);};
+            active=pending=count-1;
+            for (auto &error:errors) error=nullptr;
+            ++generation;
+        }
+        changed.notify_all();
+        std::exception_ptr error;
+        try {function(0);} catch (...) {error=std::current_exception();}
+        {
+            std::unique_lock<std::mutex> lock(mutex);
+            completed.wait(lock,[&]{return !pending;});
+            if (!error) for (const auto &candidate:errors) if (candidate) {error=candidate;break;}
+            job={}; // Release all borrowed caller state before returning/throwing.
+        }
+        if (error) std::rethrow_exception(error);
+    }
+    static gpr_parallel_workers &local() {
+        // A display caller has its own group. Concurrent immutable-plan renders
+        // on different caller threads never serialize through a global pool.
+        static thread_local gpr_parallel_workers workers;
+        return workers;
+    }
+};
+#endif
