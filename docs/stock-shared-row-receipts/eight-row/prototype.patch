+/* Experiment: compute each log sample once for a bounded shared row cache. */
+void UnpackChannelsRow14(const PACKED_IMAGE *input, int row, PIXEL *output[4])
+{
+    const uint16_t *row1 = (const uint16_t *)((const uint8_t *)input->buffer + input->offset +
+        (size_t)row * 2 * input->pitch);
+    const uint16_t *row2 = (const uint16_t *)((const uint8_t *)row1 + input->pitch);
+    const int16x4_t midpoint = vdup_n_s16(4096);
+    for (int x = 0; x < input->width/2; x += 4) {
+        int16x4_t red = vreinterpret_s16_u16(GatherChannel4(row1 + 2*x));
+        int16x4_t g1 = vreinterpret_s16_u16(GatherChannel4(row1 + 2*x + 1));
+        int16x4_t g2 = vreinterpret_s16_u16(GatherChannel4(row2 + 2*x));
+        int16x4_t blue = vreinterpret_s16_u16(GatherChannel4(row2 + 2*x + 1));
+        int16x4_t gs = vhadd_s16(g1, g2);
+        vst1_s16(output[0] + x, gs);
+        vst1_s16(output[1] + x, vhadd_s16(red, vsub_s16(midpoint, gs)));
+        vst1_s16(output[2] + x, vhadd_s16(blue, vsub_s16(midpoint, gs)));
+        vst1_s16(output[3] + x, vhadd_s16(vsub_s16(g1, g2), midpoint));
+    }
+}
