# Relocatable static-library package. Export private SDK dependencies too:
# downstream applications must not manually reconstruct their link order.
include(CMakePackageConfigHelpers)
set(GPR_PACKAGE_VERSION "0.1.0") # Experimental feature package, independent of stock SDK version macros.
set(GPR_SOURCE_REVISION "${GIT_COMMIT_HASH}" CACHE STRING "Source revision hint for packaged builds")
set(GPR_SOURCE_DIGEST "unrecorded" CACHE STRING "SHA-256 of the packaged source snapshot")
set(GPR_PACKAGE_NEEDS_ZLIB OFF)
set(GPR_PACKAGE_COMPONENTS "")
foreach(pair common:common vc5_common:codec_common vc5_encoder:encoder vc5_decoder:decoder
    gpr_sdk:sdk gpr_gvid:gvid gpr_video:capture gpr_preview:preview
    dng_sdk:dng_sdk xmp_core:xmp_core md5_lib:md5_lib expat_lib:expat_lib tiny_jpeg:tiny_jpeg)
  string(REPLACE ":" ";" parts "${pair}")
  list(GET parts 0 target)
  list(GET parts 1 exported)
  if(TARGET ${target})
    set_target_properties(${target} PROPERTIES EXPORT_NAME ${exported})
    add_library(GPR::${exported} ALIAS ${target})
    list(APPEND GPR_PACKAGE_COMPONENTS ${exported})
    install(TARGETS ${target} EXPORT GPRTargets
      ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR})
  endif()
endforeach()
if(TARGET gpr_gvid)
  set(GPR_PACKAGE_NEEDS_ZLIB ON)
  install(FILES source/lib/gpr_video/gpr_gvid.h source/lib/gpr_video/gpr_gvid_reader.h
    DESTINATION ${CMAKE_INSTALL_INCLUDEDIR}/gpr)
endif()
if(TARGET gpr_video)
  install(FILES source/lib/gpr_video/gpr_capture.h DESTINATION ${CMAKE_INSTALL_INCLUDEDIR}/gpr)
endif()
if(TARGET gpr_preview)
  install(FILES source/lib/gpr_video/gpr_preview.h DESTINATION ${CMAKE_INSTALL_INCLUDEDIR}/gpr)
endif()
install(DIRECTORY source/lib/common/public/ DESTINATION ${CMAKE_INSTALL_INCLUDEDIR}/gpr FILES_MATCHING PATTERN "*.h")
install(FILES source/lib/vc5_common/error.h source/lib/vc5_common/types.h
  source/lib/vc5_common/config.h source/lib/vc5_common/vc5_common.h DESTINATION ${CMAKE_INSTALL_INCLUDEDIR}/gpr)
if(TARGET vc5_encoder)
  install(FILES source/lib/vc5_encoder/vc5_encoder.h DESTINATION ${CMAKE_INSTALL_INCLUDEDIR}/gpr)
endif()
if(TARGET vc5_decoder)
  install(FILES source/lib/vc5_decoder/vc5_decoder.h DESTINATION ${CMAKE_INSTALL_INCLUDEDIR}/gpr)
endif()
if(TARGET gpr_sdk)
  install(DIRECTORY source/lib/gpr_sdk/public/ DESTINATION ${CMAKE_INSTALL_INCLUDEDIR}/gpr FILES_MATCHING PATTERN "*.h")
  install(FILES source/lib/dng_sdk/BSD-License.txt DESTINATION ${CMAKE_INSTALL_DATADIR}/gpr/licenses/dng_sdk)
  install(FILES source/lib/xmp_core/BSD-License.txt DESTINATION ${CMAKE_INSTALL_DATADIR}/gpr/licenses/xmp_core)
  # COPYING shipped with upstream Expat 2.1.0 (the vendored header version):
  # https://github.com/libexpat/libexpat/blob/R_2_1_0/expat/COPYING
  install(FILES source/lib/expat_lib/COPYING DESTINATION ${CMAKE_INSTALL_DATADIR}/gpr/licenses/expat)
endif()
function(gpr_install_header_notice source name)
  file(READ ${CMAKE_CURRENT_SOURCE_DIR}/${source} text)
  string(FIND "${text}" "*/" end)
  math(EXPR length "${end} + 2")
  string(SUBSTRING "${text}" 0 ${length} notice)
  file(WRITE ${CMAKE_CURRENT_BINARY_DIR}/notices/${name}.txt "${notice}\n")
  install(FILES ${CMAKE_CURRENT_BINARY_DIR}/notices/${name}.txt DESTINATION ${CMAKE_INSTALL_DATADIR}/gpr/licenses)
endfunction()
if(TARGET md5_lib)
  gpr_install_header_notice(source/lib/md5_lib/md5.h md5-header)
  gpr_install_header_notice(source/lib/md5_lib/md5.c md5-implementation)
endif()
if(TARGET tiny_jpeg)
  gpr_install_header_notice(source/lib/tiny_jpeg/tiny_jpeg.h tiny-jpeg)
endif()
foreach(app gpr_tools vc5_encoder_app vc5_decoder_app gpr_capture_app gpr_preview_app stock_video)
  if(TARGET ${app})
    install(TARGETS ${app} RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR})
  endif()
endforeach()
install(FILES tools/stock_video.py tools/raw_media.py tools/stock_still.py DESTINATION ${CMAKE_INSTALL_DATADIR}/gpr/tools)
file(GLOB package_docs "${CMAKE_CURRENT_SOURCE_DIR}/docs/stock-*")
foreach(doc ${package_docs})
  if(IS_DIRECTORY "${doc}")
    install(DIRECTORY "${doc}" DESTINATION ${CMAKE_INSTALL_DATADIR}/gpr/docs PATTERN ".DS_Store" EXCLUDE)
  else()
    install(FILES "${doc}" DESTINATION ${CMAKE_INSTALL_DATADIR}/gpr/docs)
  endif()
endforeach()
install(FILES LICENSE-APACHE LICENSE-MIT LICENSE.txt DESTINATION ${CMAKE_INSTALL_DATADIR}/gpr/licenses)
configure_file(${CMAKE_CURRENT_LIST_DIR}/build-info.txt.in ${CMAKE_CURRENT_BINARY_DIR}/gpr-build-info.txt @ONLY)
install(FILES ${CMAKE_CURRENT_BINARY_DIR}/gpr-build-info.txt DESTINATION ${CMAKE_INSTALL_DATADIR}/gpr)
install(EXPORT GPRTargets NAMESPACE GPR:: DESTINATION ${CMAKE_INSTALL_LIBDIR}/cmake/GPR)
configure_package_config_file(${CMAKE_CURRENT_LIST_DIR}/GPRConfig.cmake.in
  ${CMAKE_CURRENT_BINARY_DIR}/GPRConfig.cmake INSTALL_DESTINATION ${CMAKE_INSTALL_LIBDIR}/cmake/GPR)
write_basic_package_version_file(${CMAKE_CURRENT_BINARY_DIR}/GPRConfigVersion.cmake
  VERSION ${GPR_PACKAGE_VERSION} COMPATIBILITY ExactVersion)
install(FILES ${CMAKE_CURRENT_BINARY_DIR}/GPRConfig.cmake ${CMAKE_CURRENT_BINARY_DIR}/GPRConfigVersion.cmake
  DESTINATION ${CMAKE_INSTALL_LIBDIR}/cmake/GPR)

option(GPR_BUILD_PACKAGE "Generate experimental binary ZIP/TGZ packages with CPack" OFF)
if(GPR_BUILD_PACKAGE)
  if(TARGET gpr_sdk)
    set(profile sdk)
    if(TARGET gpr_video OR TARGET gpr_preview)
      set(profile full)
    endif()
  elseif(TARGET gpr_video AND TARGET gpr_preview)
    set(profile camera)
  elseif(TARGET gpr_video)
    set(profile capture)
  elseif(TARGET gpr_preview)
    set(profile preview)
  else()
    set(profile codec)
  endif()
  set(CPACK_PACKAGE_NAME gpr-stock-media)
  set(CPACK_PACKAGE_VERSION ${GPR_PACKAGE_VERSION})
  set(CPACK_PACKAGE_FILE_NAME "gpr-stock-media-${GPR_PACKAGE_VERSION}-${profile}-${CMAKE_SYSTEM_NAME}-${CMAKE_SYSTEM_PROCESSOR}")
  set(CPACK_GENERATOR "ZIP;TGZ")
  include(CPack)
endif()
