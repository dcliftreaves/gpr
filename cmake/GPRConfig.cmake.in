@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Threads)
if(@GPR_PACKAGE_NEEDS_ZLIB@)
  find_dependency(ZLIB)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/GPRTargets.cmake")
set(GPR_AVAILABLE_COMPONENTS "@GPR_PACKAGE_COMPONENTS@")
foreach(component ${GPR_FIND_COMPONENTS})
  if(TARGET GPR::${component})
    set(GPR_${component}_FOUND TRUE)
  else()
    set(GPR_${component}_FOUND FALSE)
  endif()
endforeach()
check_required_components(GPR)
