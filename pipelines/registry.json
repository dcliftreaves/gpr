    "ml2_q3_nohighpassquant": {
      "$doc": "Experiment E4: ML-2 with ALL highpass set to quant=1 (effectively no quant). Upper bound on what the ML-2 wavelet can produce. If THIS fails, the wavelet itself is the issue.",
