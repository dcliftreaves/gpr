      },
      "quality": 3
    },
    "ml2_q3_l2soft": {
      "$doc": "Experiment E2: ML-2 with L2 highpass quant halved. Tests if L2 highpass aliasing causes the blockiness.",
      "binary": "build-local/bin/test_fused_roundtrip",
      "env": {
        "GPR_INCLUDE_LL": "1",
        "FUSED_MULTI_LEVEL": "1",
