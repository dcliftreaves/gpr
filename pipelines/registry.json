{
  "$doc": "Pipeline registry. The ONLY place where {codec, cnn, demosaicer} triples are named. Run-gate refuses to test a pipeline that isn't here. Use the full name in artifact paths, PR descriptions, and claims_log.md — never an ad-hoc short form like 'ML2_q3_CNN' (the short form was the failure mode this scaffolding exists to fix).",
  "$naming": "codec=<codec_id>+cnn=<cnn_id>+demosaic=<demosaic_id>. Hyphens within an id are fine; '+' separates the triple. If a field is absent (e.g. no CNN), use 'none' (codec=sl_q3+cnn=none+demosaic=sips).",
  "$rules": [
    "Adding a pipeline: required fields populated, no ad-hoc 'TODO' fields.",
    "Renaming a pipeline: forbidden in same PR as an artifact run. Rename + re-run in separate PRs.",
    "If you can't fill `cnn_ckpt_sha256`, you can't register the pipeline. Run `sha256sum` on the .pt file."
  ],
  "demosaicers": {
    "sips_via_gpr_tools": {
      "$doc": "Bayer plane → DNG via gpr_tools (Adobe DNG SDK preserves color matrix from source DNG params) → PNG via macOS sips (Apple's CIRawFilter). Gold standard for color science. Requires source DNG for color matrix.",
      "binary": "build-local/source/app/gpr_tools/gpr_tools",
      "needs_source_dng": true
    }
  },
  "codecs": {
    "sl_q3": {
      "$doc": "Single-level FUSED q=3. The shipping stills codec.",
      "binary": "build-local/bin/test_fused_roundtrip",
      "env": {"GPR_INCLUDE_LL": "1"},
      "quality": 3
    },
    "sl_q11": {
      "binary": "build-local/bin/test_fused_roundtrip",
      "env": {"GPR_INCLUDE_LL": "1", "FUSED_QUALITY": "11"},
      "quality": 11
    },
    "ml2_q3": {
      "$doc": "2-level FUSED q=3. Restored 2026-05-25. NOT yet shipping for any class.",
      "binary": "build-local/bin/test_fused_roundtrip",
      "env": {"GPR_INCLUDE_LL": "1", "FUSED_MULTI_LEVEL": "1", "FUSED_WAVELET_LEVELS": "2"},
      "quality": 3
    },
    "ml2_q11": {
      "binary": "build-local/bin/test_fused_roundtrip",
      "env": {"GPR_INCLUDE_LL": "1", "FUSED_MULTI_LEVEL": "1", "FUSED_WAVELET_LEVELS": "2", "FUSED_QUALITY": "11"},
      "quality": 11
    },
    "ml3_q3": {
      "$doc": "3-level FUSED q=3. NOT shipping; documented Nyquist regression.",
      "binary": "build-local/bin/test_fused_roundtrip",
      "env": {"GPR_INCLUDE_LL": "1", "FUSED_MULTI_LEVEL": "1", "FUSED_WAVELET_LEVELS": "3"},
      "quality": 3
    },
    "ml3_q12_l1l2x4_legacy": {
      "$doc": "Historical pipeline that produced the 'looked much better' results in /Volumes/OWC_8TB/gpr_artifacts/visual_compare_20260525/. ml3 codec with L1+L2 highpass cranked 4x. Paired with cnn=bibo1x_ane_l1l2x4. The historical q=12 quality table no longer exists; we approximate via GPR_QUANT_OVERRIDE.",
      "binary": "build-local/bin/test_fused_roundtrip",
      "env": {"GPR_INCLUDE_LL": "1", "FUSED_MULTI_LEVEL": "1", "FUSED_WAVELET_LEVELS": "3",
              "GPR_QUANT_OVERRIDE": "4:48,5:48,6:24,7:384,8:384,9:576"},
      "quality": 3,
      "$note": "Reproduces the cranked-highpass distribution the L1L2x4 CNN was trained against."
    },
    "ml2_q3_l1soft": {
      "$doc": "Experiment E1: ML-2 with L1 highpass quant halved. Tests if visible blockiness is dominated by L1 highpass loss.",
      "binary": "build-local/bin/test_fused_roundtrip",
      "env": {"GPR_INCLUDE_LL": "1", "FUSED_MULTI_LEVEL": "1", "FUSED_WAVELET_LEVELS": "2",
              "GPR_QUANT_OVERRIDE": "7:48,8:48,9:72"},
      "quality": 3
    },
    "ml2_q3_l2soft": {
      "$doc": "Experiment E2: ML-2 with L2 highpass quant halved. Tests if L2 highpass aliasing causes the blockiness.",
      "binary": "build-local/bin/test_fused_roundtrip",
      "env": {"GPR_INCLUDE_LL": "1", "FUSED_MULTI_LEVEL": "1", "FUSED_WAVELET_LEVELS": "2",
              "GPR_QUANT_OVERRIDE": "4:12,5:12,6:6"},
      "quality": 3
    },
    "ml2_q3_bothsoft": {
      "$doc": "Experiment E3: ML-2 with BOTH L1 and L2 highpass quant halved.",
      "binary": "build-local/bin/test_fused_roundtrip",
      "env": {"GPR_INCLUDE_LL": "1", "FUSED_MULTI_LEVEL": "1", "FUSED_WAVELET_LEVELS": "2",
              "GPR_QUANT_OVERRIDE": "4:12,5:12,6:6,7:48,8:48,9:72"},
      "quality": 3
    },
    "ml2_q3_nohighpassquant": {
      "$doc": "Experiment E4: ML-2 with ALL highpass set to quant=1 (effectively no quant). Upper bound on what the ML-2 wavelet can produce. If THIS fails, the wavelet itself is the issue.",
      "binary": "build-local/bin/test_fused_roundtrip",
      "env": {"GPR_INCLUDE_LL": "1", "FUSED_MULTI_LEVEL": "1", "FUSED_WAVELET_LEVELS": "2",
              "GPR_QUANT_OVERRIDE": "4:1,5:1,6:1,7:1,8:1,9:1"},
      "quality": 3
    },
    "ml2_q3_ll2div8": {
      "$doc": "Experiment E5: LL2 extra divisor reduced from 16 to 8 — more LL2 fidelity.",
      "binary": "build-local/bin/test_fused_roundtrip",
      "env": {"GPR_INCLUDE_LL": "1", "FUSED_MULTI_LEVEL": "1", "FUSED_WAVELET_LEVELS": "2",
              "FUSED_LL2_DIVISOR": "8"},
      "quality": 3
    },
    "ml2_q3_ll2div4": {
      "$doc": "Experiment E5b: LL2 extra divisor = 4. May exceed rANS class-15 ceiling for some content; gate will tell.",
      "binary": "build-local/bin/test_fused_roundtrip",
      "env": {"GPR_INCLUDE_LL": "1", "FUSED_MULTI_LEVEL": "1", "FUSED_WAVELET_LEVELS": "2",
              "FUSED_LL2_DIVISOR": "4"},
      "quality": 3
    },
    "ml2_q3_combo": {
      "$doc": "Experiment E6: lighter L1+L2 highpass + lighter LL2 divisor combined.",
      "binary": "build-local/bin/test_fused_roundtrip",
      "env": {"GPR_INCLUDE_LL": "1", "FUSED_MULTI_LEVEL": "1", "FUSED_WAVELET_LEVELS": "2",
              "FUSED_LL2_DIVISOR": "8",
              "GPR_QUANT_OVERRIDE": "4:12,5:12,6:6,7:48,8:48,9:72"},
      "quality": 3
    },
    "ml2_q3_prefilter3h": {
      "$doc": "Experiment E7: 3-tap horizontal LP prefilter on LL1 before L2 cascade. Attacks horizontal-direction Nyquist aliasing in the L2 wavelet.",
      "binary": "build-local/bin/test_fused_roundtrip",
      "env": {"GPR_INCLUDE_LL": "1", "FUSED_MULTI_LEVEL": "1", "FUSED_WAVELET_LEVELS": "2",
              "FUSED_L2_PREFILTER": "3"},
      "quality": 3
    },
    "ml2_q3_prefilter3h_softq": {
      "$doc": "Experiment E7b: prefilter + lighter highpass quant. Stacked best-known mitigations.",
      "binary": "build-local/bin/test_fused_roundtrip",
      "env": {"GPR_INCLUDE_LL": "1", "FUSED_MULTI_LEVEL": "1", "FUSED_WAVELET_LEVELS": "2",
              "FUSED_L2_PREFILTER": "3",
              "GPR_QUANT_OVERRIDE": "4:12,5:12,6:6,7:48,8:48,9:72"},
      "quality": 3
    },
    "ml2_q3_prefilter3hv": {
      "$doc": "Experiment E12: 3-tap LP prefilter in BOTH X and Y on LL1 → L2. Strongest anti-alias.",
      "binary": "build-local/bin/test_fused_roundtrip",
      "env": {"GPR_INCLUDE_LL": "1", "FUSED_MULTI_LEVEL": "1", "FUSED_WAVELET_LEVELS": "2",
              "FUSED_L2_PREFILTER": "33"},
      "quality": 3
    },
    "ml2_q3_prefilter3hv_softq": {
      "$doc": "Experiment E13: H+V prefilter + lighter highpass quant.",
      "binary": "build-local/bin/test_fused_roundtrip",
      "env": {"GPR_INCLUDE_LL": "1", "FUSED_MULTI_LEVEL": "1", "FUSED_WAVELET_LEVELS": "2",
              "FUSED_L2_PREFILTER": "33",
              "GPR_QUANT_OVERRIDE": "4:12,5:12,6:6,7:48,8:48,9:72"},
      "quality": 3
    }
  },
