      "binary": "build-local/bin/test_fused_roundtrip",
      "env": {
        "GPR_INCLUDE_LL": "1",
        "FUSED_MULTI_LEVEL": "1",
        "FUSED_WAVELET_LEVELS": "2"
      },
      "quality": 3
    },
    "ml2_q11": {
      "binary": "build-local/bin/test_fused_roundtrip",
      "env": {
        "GPR_INCLUDE_LL": "1",
        "FUSED_MULTI_LEVEL": "1",
        "FUSED_WAVELET_LEVELS": "2",
        "FUSED_QUALITY": "11"
      },
      "quality": 11
    },
    "ml3_q3": {
      "$doc": "3-level FUSED q=3. NOT shipping; documented Nyquist regression.",
      "binary": "build-local/bin/test_fused_roundtrip",
      "env": {
        "GPR_INCLUDE_LL": "1",
        "FUSED_MULTI_LEVEL": "1",
        "FUSED_WAVELET_LEVELS": "3"
      },
      "quality": 3
    },
    "ml3_q12_l1l2x4_legacy": {
      "$doc": "Historical pipeline that produced the 'looked much better' results in /Volumes/OWC_8TB/gpr_artifacts/visual_compare_20260525/. ml3 codec with L1+L2 highpass cranked 4x. Paired with cnn=bibo1x_ane_l1l2x4. The historical q=12 quality table no longer exists; we approximate via GPR_QUANT_OVERRIDE.",
      "binary": "build-local/bin/test_fused_roundtrip",
      "env": {
        "GPR_INCLUDE_LL": "1",
        "FUSED_MULTI_LEVEL": "1",
        "FUSED_WAVELET_LEVELS": "3",
        "GPR_QUANT_OVERRIDE": "4:48,5:48,6:24,7:384,8:384,9:576"
      },
      "quality": 3,
      "$note": "Reproduces the cranked-highpass distribution the L1L2x4 CNN was trained against."
    },
    "ml2_q3_l1soft": {
      "$doc": "Experiment E1: ML-2 with L1 highpass quant halved. Tests if visible blockiness is dominated by L1 highpass loss.",
      "binary": "build-local/bin/test_fused_roundtrip",
      "env": {
        "GPR_INCLUDE_LL": "1",
        "FUSED_MULTI_LEVEL": "1",
        "FUSED_WAVELET_LEVELS": "2",
